# Configuration for incogniton-automation-examples.
# Copy to .env (or run `npm run setup`). Flags such as --profile-id override these values,
# and real environment variables override this file.

# Port of the local Incogniton automation API (Incogniton app: Settings > Automation). The API only listens on 127.0.0.1.
INCOGNITON_API_PORT=35000

# Profile used by the single-profile examples. Find IDs with `npm run profiles -- list`. Use a dedicated test profile.
INCOGNITON_PROFILE_ID=

# Comma-separated, distinct profile IDs for run-multiple-profiles.
INCOGNITON_PROFILE_IDS=

# true launches the profile browser with --headless=new; false opens a visible window (easier debugging). The desktop app itself must still be running and logged in.
INCOGNITON_HEADLESS=true

# Upper bound for waiting until the profile is Ready, launching it, and connecting over CDP. Cloud-synced profiles can take longer on first launch.
INCOGNITON_LAUNCH_TIMEOUT_MS=120000

# Default timeout for page actions and navigation.
INCOGNITON_ACTION_TIMEOUT_MS=15000

# Upper bound for graceful browser shutdown plus the app stop/sync pipeline.
INCOGNITON_STOP_TIMEOUT_MS=120000

# Timeout in seconds for ordinary API requests (list, status, create, delete).
INCOGNITON_API_TIMEOUT_SECONDS=30

# Directory for run artifacts (screenshots, result.json). Ignored by git.
OUTPUT_DIR=output

# Maximum profiles run-multiple-profiles drives at once. Practical limits depend on your machine and plan.
MAX_CONCURRENCY=2

# Port of the local fixture server. Keep it stable: cookies and localStorage belong to the origin http://127.0.0.1:<port>.
FIXTURE_PORT=47811

# Second fixture port used as a separate origin for the cross-origin iframe.
FIXTURE_CROSS_ORIGIN_PORT=47812
